{
  "name": "cheesybeez-cloud",
  "private": true,
  "type": "module",
  "description": "The cloud copy of every shop's events (SCRUM-61), on Cloudflare Workers + D1.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply cheesybeez-cloud --remote",
    "migrate:local": "wrangler d1 migrations apply cheesybeez-cloud --local",
    "device": "node --experimental-strip-types --no-warnings addDevice.ts"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
