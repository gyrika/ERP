    {
      "name": "API-11 a 10% discount by a logged-in manager is accepted",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"now\", Date.now());",
              "pm.collectionVariables.set(\"eid\", \"qa-\" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"accepted\", () => pm.expect(pm.response.json().rejected).to.be.undefined);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": {
          "raw": "{{base}}/api/v1/events",
          "host": [
            "{{base}}"
          ],
          "path": [
            "api",
            "v1",
            "events"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"deviceId\": \"qa\",\n  \"events\": [\n    {\n      \"id\": \"{{eid}}-ok\",\n      \"shopId\": \"{{shop}}\",\n      \"at\": {{now}},\n      \"orderNumber\": 42,\n      \"type\": \"order.discount_set\",\n      \"actor\": {{managerActor}},\n      \"totalBefore\": 190000,\n      \"totalAfter\": 0,\n      \"before\": null,\n      \"after\": {\n        \"kind\": \"percent\",\n        \"pct\": 10\n      }\n    }\n  ]\n}"
        }
      }
    },
