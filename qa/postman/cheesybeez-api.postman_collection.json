      "name": "API-04 cashier logs in with the right PIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"responds under 500 ms\", () => pm.expect(pm.response.responseTime).to.be.below(500));",
              "const j = pm.response.json(); pm.test(\"actor is the cashier\", () => pm.expect(j.actor.role).to.eql(\"cashier\")); pm.test(\"PIN hash never returned\", () => pm.expect(JSON.stringify(j)).to.not.include(\"hash\"));"
            ]
