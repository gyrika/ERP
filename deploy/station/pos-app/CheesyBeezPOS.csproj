<Project Sdk="Microsoft.NET.Sdk">
  <!--
    CheesyBeez POS: the counter's app. A small Windows program that shows the POS in Windows'
    own web engine (WebView2): its own window and icon, full screen, no browser. .NET Framework 4.8
    is part of Windows 10 and 11, so nothing extra is installed. Built by GitHub on Windows
    (.github/workflows/station.yml); the Station installer puts it beside the server.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>CheesyBeezPOS</AssemblyName>
    <RootNamespace>CheesyBeez</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <Product>CheesyBeez POS</Product>
    <Company>CheesyBeez POS team</Company>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2651.64" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>
</Project>
